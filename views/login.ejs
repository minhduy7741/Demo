<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Notes App</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="glass-container auth-box">
    <h2>Welcome Back [NHÁNH DEVELOP]</h2>
    <p class="subtitle">Login to access your notes</p>
    
    <% if (error) { %>
      <div class="alert"><%= error %></div>
    <% } %>
    
    <form action="/login" method="POST">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" required placeholder="Enter username" autocomplete="off">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" required placeholder="Enter password">
      </div>
      <button type="submit" class="btn-primary">Sign In</button>
    </form>
    
    <div class="footer-link">
      Don't have an account? <a href="/register">Create one</a>
    </div>
  </div>
</body>
</html>
